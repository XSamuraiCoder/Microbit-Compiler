{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Micro-bit Compiler",
  "version": "1.4.0",
  "identifier": "com.compiler.microbit",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Micro:bit Compiler",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": [
      "../Examples"
    ],
    "targets": ["nsis", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["python3", "python3-venv", "git"]
      },
      "rpm": {
        "depends": ["python3", "git"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxRTY5QUExMTQ1RjFDRTkKUldUcEhGOFVvWnJta1VBdFdHMDF6MkF2NFVuMEZidnREcDhRbFIyaUJJbTcvQWFrSjdCZFF2ZWsK",
      "endpoints": [
        "https://github.com/coolprojects123/Microbit-Compiler/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}